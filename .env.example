# Database (PostgreSQL) — e.g. local Postgres, Supabase, Neon, Railway
DATABASE_URL="postgresql://user:password@localhost:5432/events_partner?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (optional — leave blank to hide the buttons)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend). Leave blank to run in MOCK EMAIL MODE (logged, not sent).
RESEND_API_KEY=""
EMAIL_FROM="Events Partner <no-reply@eventspartner.app>"

# SMS (Twilio-compatible). Leave blank to run in MOCK SMS MODE (logged, not sent).
SMS_PROVIDER_ACCOUNT_SID=""
SMS_PROVIDER_AUTH_TOKEN=""
SMS_PROVIDER_FROM_NUMBER=""

# Scheduled messages: Vercel Cron calls /api/cron/send-scheduled with "Authorization: Bearer <CRON_SECRET>".
# The endpoint refuses to run if this is unset. Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# App — set to the public https:// URL in production (used for RSVP links, QR codes, emails, metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public contact address shown on the Privacy Policy and Terms pages (required before going live)
NEXT_PUBLIC_SUPPORT_EMAIL=

# Extra admin emails, comma-separated (also honoured; same rules as below)
ADMIN_EMAILS=

# Admin bootstrap — the account with this email is promoted to ADMIN when it signs in with Google
# (on a local machine, registering with this email also works)
ADMIN_BOOTSTRAP_EMAIL="captleviste23@gmail.com"
